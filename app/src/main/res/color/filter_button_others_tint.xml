<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When checked, use the solid color for "Others" cards -->
    <item android:state_checked="true" android:color="@color/accentSoftLavender" />
