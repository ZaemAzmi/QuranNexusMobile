<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when button is checked -->
    <item android:state_checked="true" android:color="@color/accent_bright_teal" />
    <!-- Default state (unchecked). Make it transparent to show the parent's gradient. -->
    <item android:color="@android:color/transparent" />
</selector>