<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.QuranNexus.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="backgroundTint">@color/dark_green_200</item>
        <item name="android:layout_marginBottom">17dp</item>
    </style>

    <style name="Widget.QuranNexus.BottomAppBar" parent="Widget.MaterialComponents.BottomAppBar">
        <item name="fabCradleRoundedCornerRadius">35dp</item>
        <item name="fabCradleMargin">14dp</item>
        <item name="fabCradleVerticalOffset">10dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="fabAlignmentMode">center</item>
        <item name="fabAnimationMode">slide</item>

        <item name="backgroundTint">@color/light_green_side_nav</item>
    </style>

    <style name="Widget.QuranNexus.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_gravity">bottom</item>
        <item name="menu">@menu/bottom_navigation_menu</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>


    <style name="Widget.QuranNexus.CustomTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/dark_green_200</item>
        <item name="tabSelectedTextColor">@color/dark_green_200</item>
        <item name="tabTextColor">@color/black</item>
        <item name="background">@color/transparent</item>
    </style>

    <style name="PreferenceCategoryStyle" parent="Preference.Category">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingTop">16dp</item>
    </style>

    <!-- res/values/themes.xml -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up_dialog</item>
        <item name="android:windowExitAnimation">@anim/slide_down_dialog</item>
    </style>

    <style name="TransparentDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="NavDrawerItemTextAppearance" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="Widget.App.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemIconSize">@dimen/width_medium</item>
        <item name="itemTextAppearance">@style/NavDrawerItemTextAppearance</item>
        <item name="itemIconPadding">@dimen/padding_intermediate</item>
        <item name="itemHorizontalPadding">@dimen/padding_intermediate</item>
    </style>

    <style name="FullScreenDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <!-- Make it extend from a Dialog theme -->
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- Styles for the Search Help Section -->
    <style name="SearchHelpChipTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:layout_marginTop">@dimen/margin_intermediate</item>
    </style>

    <style name="SearchHelpChipExplanation" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:layout_marginStart">@dimen/margin_intermediate</item>
    </style>

    <style name="SearchHelpChipExample" parent="SearchHelpChipExplanation">
        <item name="android:textStyle">italic</item>
    </style>
    <style name="Widget.App.FilterToggleButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAllCaps">false</item>

        <!-- THIS IS THE FIX: Explicitly remove the button's stroke -->
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="ShapeAppearance.App.ToggleButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Button.LeftCurved" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Shape for the MIDDLE buttons -->
    <style name="ShapeAppearanceOverlay.App.Button.Middle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Shape for the RIGHT button -->
    <style name="ShapeAppearanceOverlay.App.Button.RightCurved" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>
</resources>