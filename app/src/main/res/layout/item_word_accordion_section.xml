<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_intermediate"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header (Title and Count) -->
            <LinearLayout
                android:id="@+id/accordionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/textViewSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    android:text="أ"
                    android:textSize="@dimen/text_size_xxlarge"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/textViewItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(5)"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/imageViewExpandCollapse"
                    android:layout_width="@dimen/width_medium"
                    android:layout_height="@dimen/height_medium"
                    android:layout_marginStart="@dimen/margin_intermediate"
                    android:src="@drawable/ic_expand_more"
                    android:contentDescription="@string/expand_collapse_icon" />
            </LinearLayout>

            <!-- Child Items -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewWordAccordionChildItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
