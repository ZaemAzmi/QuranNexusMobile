<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_tiny">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBadge"
        android:layout_width="@dimen/achievement_medal_width"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_intermediate"
        android:paddingBottom="@dimen/padding_tiny"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:background="@drawable/bg_rounded_badge_card"
        app:layout_constraintWidth_percent="0.22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/padding_small"
            android:clickable="true">

            <!-- Badge Icon -->
            <ImageView
                android:id="@+id/ivBadgeIcon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/badge_12"
                android:contentDescription="Badge Icon" />

            <!-- Badge Title -->
            <TextView
                android:id="@+id/tvBadgeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Badge Name"
                android:paddingBottom="@dimen/padding_tiny"
                android:textSize="@dimen/text_size_small"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_intermediate"
                android:textStyle="bold"
                android:textColor="@color/black" />

        </LinearLayout>
        </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
