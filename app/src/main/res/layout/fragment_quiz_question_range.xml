<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <ImageView
            android:id="@+id/backArrowImageView"
            android:layout_width="@dimen/width_medium"
            android:layout_height="@dimen/height_medium"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginBottom="@dimen/margin_medium" />

        <TextView
            android:id="@+id/chapterNumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            tools:text="Chapter 1" />

        <TextView
            android:id="@+id/totalQuestionsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_intermediate"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_medium"
            tools:text="Total Questions: 100" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewBatches"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_quiz_batch" />

    </LinearLayout>
</layout>