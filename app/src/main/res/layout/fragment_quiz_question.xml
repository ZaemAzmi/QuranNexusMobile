<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_quiz1"
        tools:context=".features.quiz.QuizQuestionFragment">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <ImageView
            android:id="@+id/previousButton"
            android:src="@drawable/ic_arrow_left"
            android:layout_width="@dimen/width_xlarge"
            android:layout_height="@dimen/height_xlarge"
            android:background="@drawable/bg_circle_white"
            android:layout_margin="@dimen/margin_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <ImageView
            android:id="@+id/showHintButton"
            android:src="@drawable/ic_show_hint"
            android:layout_width="@dimen/width_xlarge"
            android:layout_height="@dimen/height_xlarge"
            android:layout_margin="@dimen/margin_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/translationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hint Goes here"
            android:textSize="@dimen/text_size_small"
            android:layout_marginTop="@dimen/margin_large"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_medium"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@+id/previousButton"
            app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_large"
            android:background="@drawable/bg_rounded_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:textSize="@dimen/text_size_medium"
                android:text="( 6/10 )"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.cardview.widget.CardView
                android:id="@+id/questionCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@color/white"
                app:cardCornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@+id/progressText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quiz_question"
                    android:padding="@dimen/padding_medium"
                    android:gravity="center"
                    android:minHeight="@dimen/quiz_question_card_height"
                    android:text="Questions goes here"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <RadioGroup
                android:id="@+id/optionsGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_xlarge"
                app:layout_constraintTop_toBottomOf="@id/questionCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioButton
                    android:id="@+id/optionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:background="@drawable/rounded_recyclerview_background_white"
                    android:text="Option A"
                    android:buttonTint="@color/light_green_button"
                    android:textSize="@dimen/text_size_large"
                    android:padding="@dimen/padding_intermediate"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/optionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:text="Option B"
                    android:background="@drawable/rounded_recyclerview_background_white"
                    android:buttonTint="@color/light_green_button"
                    android:textSize="@dimen/text_size_large"
                    android:padding="@dimen/padding_intermediate"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/optionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:text="Option C"
                    android:background="@drawable/rounded_recyclerview_background_white"
                    android:buttonTint="@color/light_green_button"
                    android:textSize="@dimen/text_size_large"
                    android:padding="@dimen/padding_intermediate"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/optionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:text="Option D"
                    android:background="@drawable/rounded_recyclerview_background_white"
                    android:buttonTint="@color/light_green_button"
                    android:textSize="@dimen/text_size_large"
                    android:padding="@dimen/padding_intermediate"
                    android:textColor="@android:color/black" />
            </RadioGroup>
            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:backgroundTint="#1D6F8F"
                android:text="Submit"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_xxlarge"
                app:layout_constraintTop_toBottomOf="@id/optionsGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>