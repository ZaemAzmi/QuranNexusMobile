<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".features.recitation.ByPageRecitationFragment">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/fragmentByPageRecitationViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ayah_card_dark_green_400" />

    <TextView
        android:id="@+id/pageNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:lineSpacingExtra="@dimen/margin_tiny"
        android:layout_marginBottom="@dimen/meow_bottom_nav_height"
        android:textColor="@color/white"
        android:padding="@dimen/padding_medium"
        android:textSize="@dimen/text_size_large" />
    <include
        android:id="@+id/audioPlayerLayout"
        layout="@layout/layout_floating_audio_player" />
</FrameLayout>
