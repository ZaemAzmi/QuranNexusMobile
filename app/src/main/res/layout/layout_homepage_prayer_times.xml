<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false" android:paddingBottom="@dimen/prayer_card_image_overlap_allowance"> <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/prayerCardBackground"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_homepage_prayertimes_background_gradient"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/prayer_card_padding"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_image_start"
        android:layout_marginEnd="@dimen/margin_small">
        <TextView
        android:id="@+id/nextPrayerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Asr"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />

        <TextView
            android:id="@+id/timerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="in 1:23:45"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium" />

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="17 Apr 2025 / 17 Ramadan 1446"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_small"
            android:layout_marginTop="@dimen/margin_tiny"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_image_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6"/>
</androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/mosqueImageView"
        android:layout_width="@dimen/prayer_card_image_width"
        android:layout_height="@dimen/prayer_card_image_height"
        android:src="@drawable/img_mosque"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/prayer_card_image_margin_end"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>