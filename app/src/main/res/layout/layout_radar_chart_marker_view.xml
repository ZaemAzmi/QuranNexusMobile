<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/padding_medium"
    android:paddingVertical="@dimen/padding_intermediate"
    android:minWidth="@dimen/radar_chart_popup_min_height"
    android:background="@drawable/marker_background_radar_chart">

    <TextView
        android:id="@+id/tvChapterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/white"/>

    <TextView
        android:id="@+id/tvChapterNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:gravity="center"
        android:layout_marginTop="@dimen/margin_tiny"
        android:textColor="@android:color/white"/>

    <View
        android:layout_width="@dimen/width_xxlarge"
        android:layout_height="1dp"
        android:layout_gravity="center"
        android:layout_marginVertical="@dimen/margin_intermediate"
        android:background="@android:color/white"/>

    <TextView
        android:id="@+id/tvWordsProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:gravity="center"
        android:textColor="@android:color/white"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_super_tiny"
        android:layout_marginTop="@dimen/margin_intermediate"
        android:layout_marginBottom="@dimen/margin_tiny"
        android:progressTint="@android:color/white"
        android:progressBackgroundTint="#80FFFFFF"/>

    <TextView
        android:id="@+id/tvPercentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/white"/>
</LinearLayout>