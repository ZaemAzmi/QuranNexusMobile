<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- badge_card.xml -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#72FBD4"
        android:padding="@dimen/padding_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivPopupBadgeIcon"
            android:layout_width="@dimen/popup_badge_width"
            android:layout_height="@dimen/popup_badge_height"
            android:src="@drawable/badge_12"
            android:contentDescription="Badge Icon" />

        <TextView
            android:id="@+id/tvPopupBadgeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge Name"
            android:textSize="@dimen/text_size_small"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_intermediate"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvPopupBadgeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge Description"
            android:textSize="@dimen/text_size_tiny"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_tiny"
            android:textColor="@color/gray" />

        <Button
            android:id="@+id/btnShareBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_medium"
            android:backgroundTint="@color/black"
            android:textColor="@color/white" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>