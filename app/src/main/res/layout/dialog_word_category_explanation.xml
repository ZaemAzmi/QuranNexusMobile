<?xml version="1.0" encoding="utf-8"?>
<!-- The root is a LinearLayout to correctly handle the custom background and shadow -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_word_category"
    android:elevation="8dp"> <!-- Use elevation for the shadow effect -->

    <!-- All children are direct children of the root LinearLayout -->

    <ImageView
        android:id="@+id/ivDialogCategoryIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:tint="?attr/colorPrimary"
        tools:src="@drawable/ic_root_placeholder" />

    <TextView
        android:id="@+id/tvDialogCategoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textSize="@dimen/arabic_text_size"
        tools:text="Quranic Roots (أصل - Aṣl)" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:minHeight="150dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogCategoryExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingMultiplier="1.2"
                android:textSize="@dimen/text_size_medium"
                tools:text="A root is typically a three-letter (triliteral) base from which many Arabic words are derived..." />

            <TextView
                android:id="@+id/tvDialogExamplesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Example(s):"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_xlarge" />

            <TextView
                android:id="@+id/tvDialogCategoryExamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textDirection="ltr"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingMultiplier="1.2"
                android:textSize="@dimen/text_size_medium"
                tools:text="Root: ك-ت-ب (k-t-b) relates to writing.\n- كَتَبَ (kataba) - he wrote\n- كِتَاب (kitāb) - book" />

            <TextView
                android:id="@+id/tvDialogAppRelevanceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="In This App:"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/tvDialogAppRelevance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingMultiplier="1.2"
                android:textSize="@dimen/text_size_medium"
                tools:text="When you analyze a word by its ROOT, you see all Quranic words derived from that fundamental concept."/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogCategoryClose"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Got it" />

</LinearLayout>