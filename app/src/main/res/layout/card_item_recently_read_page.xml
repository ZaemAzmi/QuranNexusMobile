<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/padding_medium">

    <androidx.cardview.widget.CardView
        android:id="@+id/recentlyReadPageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="@color/surah_card_dark_green_300"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/recentlyReadPageNumberFrame"
                android:layout_width="@dimen/number_frame_width"
                android:layout_height="@dimen/number_frame_height"
                android:layout_marginStart="@dimen/margin_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">


            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:src="@drawable/surah_number_frame" />

                <com.example.qurannexus.core.customViews.AutoFitTextView
                    android:id="@+id/recentlyReadPageNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="35"
                    android:textAppearance="@style/TextAppearance.SurahNumber"/>

            </FrameLayout>

            <TextView
                android:id="@+id/recentlyReadPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="Page 35"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toEndOf="@id/recentlyReadPageNumberFrame"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/recentlyReadPageSurahInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="Al-Baqarah (البقرة)"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toEndOf="@id/recentlyReadPageNumberFrame"
                app:layout_constraintTop_toBottomOf="@id/recentlyReadPageTitle" />

            <TextView
                android:id="@+id/recentlyReadPageDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="13 Feb 2025 / 15 Rajab 1446"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_tiny"
                app:layout_constraintStart_toEndOf="@id/recentlyReadPageNumberFrame"
                app:layout_constraintTop_toBottomOf="@id/recentlyReadPageSurahInfo" />

            <TextView
                android:id="@+id/recentlyReadPageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="10:30 PM"
                android:textColor="#FFFFFF"
                android:paddingBottom="@dimen/padding_medium"
                android:textSize="@dimen/text_size_tiny"
                app:layout_constraintStart_toEndOf="@id/recentlyReadPageNumberFrame"
                app:layout_constraintTop_toBottomOf="@id/recentlyReadPageDate" />

            <ImageView
                android:id="@+id/recentlyReadPageMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vertical_dots_menu"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/recentlyReadPageJuzInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="Juz 3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/margin_medium" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>