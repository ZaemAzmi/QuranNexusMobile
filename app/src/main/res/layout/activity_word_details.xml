<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_daily_word"
        android:padding="@dimen/padding_medium">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />

        <!-- Top Bar with Title -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/padding_small">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/width_xlarge"
                android:layout_height="@dimen/height_xlarge"
                android:padding="@dimen/padding_small"
                android:src="@drawable/ic_arrow_left"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Word Analysis"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/textColorPrimary"/>

            <ImageView
                android:id="@+id/bookmarkButton"
                android:layout_width="@dimen/width_xlarge"
                android:layout_height="@dimen/height_xlarge"
                android:padding="@dimen/padding_tiny"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_circle_white"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/padding_medium">

                <!-- Word Text Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <TextView
                            android:id="@+id/wordText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Word"
                            android:textSize="@dimen/text_size_word_analysis"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/textColorPrimary"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginVertical="@dimen/margin_semi_medium"/>

                        <TextView
                            android:id="@+id/translationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_large"
                            android:textColor="@color/textColorPrimary"/>

                        <TextView
                            android:id="@+id/transliterationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="italic"
                            android:layout_marginTop="@dimen/margin_tiny"
                            android:textColor="@color/textColorSecondary"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Details Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="First Occurrence Details"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold"
                            android:textColor="@color/textColorPrimary"
                            android:layout_marginBottom="@dimen/margin_semi_medium"/>

                        <TextView
                            android:id="@+id/surahNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>
                        <TextView
                            android:id="@+id/verseText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textDirection="rtl"
                            android:gravity="left"
                            android:textSize="@dimen/text_size_medium"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>
                        <TextView
                            android:id="@+id/ayahKeyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>

                        <TextView
                            android:id="@+id/pageIdText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>
                        <TextView
                            android:id="@+id/juzIdText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>
                        <Button
                            android:id="@+id/playAudioButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Listen to Verse"
                            android:visibility="gone"
                            android:layout_marginTop="@dimen/margin_intermediate"
                            android:backgroundTint="@color/black"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Distribution Analysis Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Distribution Analysis"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold"
                            android:textColor="@color/textColorPrimary"
                            android:layout_marginBottom="@dimen/margin_semi_medium"/>

                        <TextView
                            android:id="@+id/tvTotalOccurrences"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:textColor="@color/textColorPrimary"
                            android:layout_marginBottom="@dimen/margin_intermediate"/>

                        <TextView
                            android:id="@+id/tvMostLeastOccurrences"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_medium"
                            android:textColor="@color/textColorPrimary"
                            android:layout_marginBottom="@dimen/margin_medium"/>

                        <!-- Changed to FrameLayout for PieChart -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="600dp"
                            android:layout_marginTop="@dimen/margin_intermediate"
                            android:layout_marginBottom="@dimen/margin_medium">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:minHeight="600dp"/>

                        </FrameLayout>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChart"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:visibility="gone"
                            android:layout_margin="16dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</layout>