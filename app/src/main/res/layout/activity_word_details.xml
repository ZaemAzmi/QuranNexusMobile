<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_daily_word"
    android:padding="@dimen/padding_medium"
    tools:context=".features.words.WordDetailsActivity">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_small">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_size_standard"
            android:layout_height="@dimen/icon_size_standard"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Back"
            android:padding="@dimen/padding_small"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Root Word Analysis"
            android:textColor="@color/textColorPrimary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/bookmarkButton"
            android:layout_width="@dimen/icon_size_standard"
            android:layout_height="@dimen/icon_size_standard"
            android:background="@drawable/bg_circle_white"
            android:padding="@dimen/padding_tiny"
            android:src="@drawable/ic_heart"
            android:visibility="visible" /> <!-- Hide for now, implement later -->
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_medium">

            <!-- Root Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">
                    <TextView
                        android:id="@+id/tvRootLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        tools:text="Root: ك ت ب"
                        android:textColor="@color/textColorPrimary"/>
                    <TextView
                        android:id="@+id/tvRootTotalOccurrences"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="Total Root Occurrences: 150"
                        android:textColor="@color/textColorSecondary"
                        android:layout_marginTop="@dimen/margin_tiny"/>
                    <!-- Morph Forms Display Area -->
                    <TextView
                        android:id="@+id/tvContributingMorphFormsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Associated Morphological Forms (Root Level)"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/margin_semi_medium"
                        android:textColor="@color/textColorPrimary"
                        android:visibility="gone"/>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexboxMorphForms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:flexWrap="wrap"
                        app:alignItems="flex_start"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnShowAllMorphForms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show All Morph Forms"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/margin_small"
                        android:visibility="gone"
                        tools:visibility="visible" />
                    <!-- Old tvContributingMorphForms can be removed if using Flexbox -->
                    <TextView
                        android:id="@+id/tvContributingMorphForms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/textColorSecondary"
                        android:layout_marginTop="@dimen/margin_tiny"
                        tools:text="Morph Forms: katab, yaktubu, kitab"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Arabic Form Selection and Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:id="@+id/tvTitleArabicFormsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Arabic Forms of this Root"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="@dimen/margin_small"/>

                    <Spinner
                        android:id="@+id/spinnerArabicForms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_small"
                        android:textDirection="ltr"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@drawable/spinner_background_selector" /> <!-- Style spinner background -->


                    <TextView
                        android:id="@+id/tvSelectedFormArabicText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="كَتَبَ"
                        android:textSize="@dimen/text_size_word_analysis"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/textColorPrimary"/>

                    <Button
                        android:id="@+id/btnPlaySelectedFormAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play Audio"
                        android:textColor="@color/bottom_nav_dark_green"
                        android:layout_gravity="center_horizontal"
                        android:textSize="@dimen/text_size_tiny"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:visibility="visible"
                        app:icon="@drawable/ic_play_audio"
                        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"/>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="@dimen/margin_semi_medium"/>

                    <LinearLayout
                        android:id="@+id/layoutTranslationSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Translation: "
                            android:textSize="@dimen/text_size_large"
                            android:textColor="@color/textColorPrimary"/>

                        <TextView
                            android:id="@+id/tvSelectedFormTranslation_main"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            tools:text="He wrote"
                            android:textSize="@dimen/text_size_large"
                            android:textColor="@color/textColorPrimary"/>

                        <ImageView
                            android:id="@+id/ivMoreTranslations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_expand_more"
                            android:visibility="gone"
                            android:layout_marginStart="@dimen/margin_intermediate"
                            android:contentDescription="More translations"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSelectedFormTransliteration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Transliteration: kataba"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="italic"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:textColor="@color/textColorSecondary"/>
                    <TextView
                        android:id="@+id/tvSelectedFormCharacters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Characters: ك - ت - ب"
                        android:textSize="@dimen/text_size_xxlarge"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:textColor="@color/textColorSecondary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- First Occurrence Details Card (of the Root) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:id="@+id/tvTitleFirstOccurrenceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="First Occurrence of Root Word"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="@dimen/margin_semi_medium"/>

                    <TextView
                        android:id="@+id/tvFirstOccSurahName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Surah: Al-Baqarah (2)"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>
                    <TextView
                        android:id="@+id/tvFirstOccVerseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textDirection="ltr"
                        android:gravity="start"
                        tools:text="Word in First Verse: كَتَبَ"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>
                    <TextView
                        android:id="@+id/tvFirstOccAyahKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Ayah Key: 2:282:15"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>
                    <TextView
                        android:id="@+id/tvFirstOccJuzId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Juz: 3"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>
                    <TextView
                        android:id="@+id/tvFirstOccPageId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Page ID: 48"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>
                    <TextView
                        android:id="@+id/tvFirstOccCharacters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Word Characters: ك - ت - ب"
                        android:textSize="@dimen/text_size_medium"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:textColor="@color/textColorSecondary"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Distribution Analysis Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:id="@+id/tvTitleDistributionAnalysisCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Root Word Distribution in Juz"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="@dimen/margin_semi_medium"/>

                    <TextView
                        android:id="@+id/tvChartTotalOccurrences"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Total Occurrences (Root): 150"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="@dimen/margin_intermediate"/>

                    <TextView
                        android:id="@+id/tvChartMostLeastOccurrences"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Most: Juz 2 (20), Least: Juz 15 (1)"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="@dimen/margin_medium"/>

                    <FrameLayout
                        android:id="@+id/pieChartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="500dp"
                        android:layout_marginTop="@dimen/margin_intermediate"
                        android:layout_marginBottom="@dimen/margin_medium">
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <!-- BarChart is removed for now, can be re-added if needed -->
                    <!-- <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:visibility="gone"
                        android:layout_margin="16dp" /> -->
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>