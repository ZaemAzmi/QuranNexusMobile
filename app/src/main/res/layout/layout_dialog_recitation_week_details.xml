<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Weekly Recitation Details"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:layout_marginBottom="@dimen/margin_medium"/>

    <TextView
        android:id="@+id/tvWeekDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mar 01 - Mar 07"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_medium"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_medium"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTotalMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120 mins"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryColor"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Time"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAverageDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 mins/day"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryColor"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average"
                    android:textSize="12sp"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressDaysRecited"
                    android:layout_width="@dimen/width_xxxlarge"
                    android:layout_height="@dimen/height_xxxlarge"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/primaryColor"
                    app:trackColor="#E0E0E0"
                    app:indicatorSize="@dimen/daily_recitation_indicator_size"
                    app:trackThickness="4dp"
                    app:indicatorDirectionCircular="clockwise"/>

                <TextView
                    android:id="@+id/tvDaysRecited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 of 7"
                    android:textSize="@dimen/text_size_tiny"
                    android:textStyle="bold"
                    android:layout_gravity="center"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Breakdown"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_intermediate"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDailyBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:maxHeight="300dp"/>

</LinearLayout>