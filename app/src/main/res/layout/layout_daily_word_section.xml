<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Bind variables if needed -->
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0.7"
            android:background="@drawable/bg_gradient_daily_word"
            android:padding="@dimen/padding_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word of the day"
                android:textSize="@dimen/text_size_large"
                />

            <!-- Arabic Word -->
            <TextView
                android:id="@+id/arabicWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="الْحَمْدُ لِلَّهِ"
                android:layout_marginTop="@dimen/margin_semi_medium"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <!-- Brief Explanation -->
            <TextView
                android:id="@+id/wordExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_intermediate"
                android:text="This phrase means 'All praise is due to Allah' and is often used as a form of gratitude in Islamic culture."
                android:textSize="@dimen/text_size_medium"
                android:textColor="#1B8C32"
                android:lineSpacingExtra="2dp" />

            <!-- Buttons Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:gravity="end|bottom">


                <!-- Bookmark Button -->
                <ImageView
                    android:id="@+id/bookmarkButton"
                    android:layout_width="@dimen/width_xlarge"
                    android:layout_height="@dimen/height_xlarge"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="Bookmark this word"
                    android:layout_marginEnd="@dimen/margin_medium" />

                <!-- Read More Text -->
                <TextView
                    android:id="@+id/readMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read more"
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>
