<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="@dimen/icon_size_standard"
        android:layout_height="@dimen/icon_size_standard"
        android:src="@drawable/ic_bullet_point"
        android:layout_marginEnd="8dp"
        app:tint="@color/dark_blue_200" />

    <TextView
        android:id="@+id/tvTranslationTextItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="A specific translation for the word."
        android:textSize="@dimen/text_size_large"
        android:textColor="?attr/colorOnSurfaceVariant"/>
</LinearLayout>