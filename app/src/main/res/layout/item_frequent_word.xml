<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wordCard"
    android:layout_width="@dimen/frequent_word_card_width"
    android:layout_height="@dimen/frequent_word_card_height"
    android:layout_margin="@dimen/margin_tiny"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_intermediate">

        <TextView
            android:id="@+id/arabicTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/uthmanic_scripts_hafs"
            android:gravity="center"
            android:textColor="@color/dark_bluee_200"
            android:textSize="@dimen/recitation_text_size" />

        <TextView
            android:id="@+id/translationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_intermediate"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium" />

        <TextView
            android:id="@+id/occurrencesTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_intermediate"
            android:gravity="center"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>
</androidx.cardview.widget.CardView>