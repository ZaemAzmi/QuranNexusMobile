<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/width_medium"
                    android:layout_height="@dimen/height_medium"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/margin_xlarge"
                    android:layout_toEndOf="@+id/backButton"
                    android:text="Search Results"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textStyle="bold" />

            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
        <TextView
            android:id="@+id/totalResultsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="256 results found"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toggle_group_gradient"
            android:elevation="2dp">

            <!-- The ToggleGroup now only manages the checking logic. It no longer controls the shape. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/filterToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <!-- Button 1: LEFT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterButtonAll"
                    style="@style/Widget.App.FilterToggleButton"
                    android:text="All"
                    android:textColor="@color/filter_button_text_color"
                    app:backgroundTint="@color/filter_button_all_tint"
                    app:iconTint="@color/filter_button_text_color"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Button.LeftCurved" />

                <!-- Button 2: MIDDLE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterButtonRoot"
                    style="@style/Widget.App.FilterToggleButton"
                    android:text="Roots"
                    android:textColor="@color/filter_button_text_color_light_bg"
                    app:backgroundTint="@color/filter_button_root_tint"
                    app:iconTint="@color/filter_button_text_color_light_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Button.Middle" />

                <!-- Button 3: MIDDLE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterButtonLemma"
                    style="@style/Widget.App.FilterToggleButton"
                    android:text="Lemmas"
                    android:textColor="@color/filter_button_text_color_light_bg"
                    app:backgroundTint="@color/filter_button_lemma_tint"
                    app:iconTint="@color/filter_button_text_color_light_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Button.Middle" />

                <!-- Button 4: RIGHT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterButtonOthers"
                    style="@style/Widget.App.FilterToggleButton"
                    android:text="Others"
                    android:textColor="@color/filter_button_text_color_light_bg"
                    app:backgroundTint="@color/filter_button_others_tint"
                    app:iconTint="@color/filter_button_text_color_light_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Button.RightCurved" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frameLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/padding_medium"
            android:scrollbars="vertical"
            android:fastScrollEnabled="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/noResultsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_xlarge"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_no_search_results"
                app:tint="@color/textTertiary" />

            <TextView
                android:id="@+id/noResultsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No words found matching your search."
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_medium" />

        </LinearLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_deep_indigo_purple"
        app:layout_anchor="@+id/frameLayout2"
        app:layout_anchorGravity="center" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>