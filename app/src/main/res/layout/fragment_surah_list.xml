<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   >
    <View
        android:id="@+id/sideMenuView"
        android:layout_width="@dimen/side_menu_icon_width"
        android:layout_height="@dimen/side_menu_icon_height"
        android:layout_marginStart="@dimen/side_menu_icon_margin_start"
        android:layout_marginTop="@dimen/side_menu_icon_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <SearchView
        android:id="@+id/searchSurahView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginEnd="@dimen/margin_large"
        android:background="@drawable/search_view_bg"
        android:elevation="@dimen/elevation_small"
        android:iconifiedByDefault="false"
        android:queryHint="Find Surah..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideMenuView"
        app:layout_constraintTop_toTopOf="parent"
      />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/SurahRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_medium"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/padding_small"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/card_item_single_surah"
        app:layout_constraintTop_toBottomOf="@id/searchSurahView"/>

    <include
        android:id="@+id/errorView"
        layout="@layout/layout_surah_list_error_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>