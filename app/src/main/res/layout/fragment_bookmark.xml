<!--        android:layout_marginEnd="@dimen/margin_medium"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent" />-->
    <View
        android:id="@+id/sideMenuView"
        android:layout_width="@dimen/side_menu_icon_width"
        android:layout_height="@dimen/side_menu_icon_height"
        android:layout_marginStart="@dimen/side_menu_icon_margin_start"
        android:layout_marginTop="@dimen/side_menu_icon_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <!-- TabLayout below the search bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="@dimen/bookmark_tabs_height"
        android:layout_marginTop="@dimen/margin_medium"
        app:tabMode="scrollable"
        android:layout_marginStart="@dimen/margin_tiny"
        app:tabMaxWidth="0dp"
        app:tabMinWidth="0dp"
        app:tabIndicatorFullWidth="false"
        android:clipToPadding="false"
        app:tabIndicatorHeight="0dp"
        app:tabPaddingStart="@dimen/padding_medium"
        app:tabPaddingEnd="@dimen/padding_medium"
        app:tabTextColor="@color/black"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabSelectedTextColor="@color/white"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/sideMenuView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager2 for sliding between tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>